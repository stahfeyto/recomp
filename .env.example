# Copia este ficheiro para .env.local e preenche. O .env.local NUNCA é commitado.

# Ligação à Neon (Vercel → Storage → Neon, ou console.neon.tech). Usa a connection string "pooled".
# Para experimentar localmente sem Neon: DATABASE_URL="pglite:.pglite" (Postgres local numa pasta, não commitada).
DATABASE_URL="postgres://utilizador:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# String aleatória com 32+ caracteres (ex.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
AUTH_SECRET=""

# Entre aspas por causa do espaço.
ADMIN_USERNAME="Helder Valente"

# Hash bcrypt da password. NUNCA a password em texto simples (este ficheiro vai para o GitHub;
# os valores reais vão só no .env.local e na Vercel).
# Gera-o com: npm run hash-password — usa a 1.ª linha (com \$) no .env.local e a 2.ª na Vercel.
ADMIN_PASSWORD_HASH=""
